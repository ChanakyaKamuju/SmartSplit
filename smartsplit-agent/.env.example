# Copy to .env and fill in. .env is gitignored.

# --- OpenAI (agent only; the MCP server never calls OpenAI) ---
OPENAI_API_KEY=sk-...
# Pick one from: python scripts/list_models.py
OPENAI_MODEL=

# --- SmartSplitAI backend ---
SMARTSPLIT_API_URL=http://localhost:5000/api

# Optional. When set, the MCP server logs in by itself, so your SmartSplitAI
# password is never sent to OpenAI. Leave blank to make the agent call
# login(email, password) explicitly instead.
SMARTSPLIT_EMAIL=
SMARTSPLIT_PASSWORD=

# --- Safety ---
# Deletions and removals are IRREVERSIBLE: the API has no soft delete and no
# backup. With this false (the default) those five tools are not registered at
# all. Run scripts/snapshot_db.py before enabling it.
SMARTSPLIT_ALLOW_DESTRUCTIVE=false

# Reject an identical expense re-submitted within this many seconds.
SMARTSPLIT_DEDUPE_WINDOW=60

# HTTP timeout, seconds.
SMARTSPLIT_TIMEOUT=20
